# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Data (large scraped datasets / generated indexes)
data/
data/raw/
data/index/

# Vector indexes & other binary artifacts -- defense-in-depth beyond the
# data/ blanket ignore above, in case a dataset/index file ever ends up
# outside data/ (e.g. a stray root-level export).
*.pkl
*.faiss
*.bin
*.sqlite3

# Node dependencies
node_modules/


# Testing
.pytest_cache/
.coverage