# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.local

# Data (large scraped datasets / generated indexes)
data/raw/

# Keep placeholder files even though data is ignored
!data/raw/.gitkeep
!data/index/.gitkeep

# Vector indexes & other binary artifacts -- defense-in-depth
*.pkl
*.faiss
*.bin
*.sqlite3

# Exceptions: Track the built vector index files for deployment
!data/index/
!data/index/*.pkl
!data/index/*.faiss

# Node dependencies and Next.js builds
node_modules/
.next/

# Testing
.pytest_cache/
.coverage